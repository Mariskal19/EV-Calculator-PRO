<resources>
    <style name="Theme.EVChargeCalculator" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F4F8FF</item>
        <item name="android:navigationBarColor">#F4F8FF</item>
        <item name="android:colorAccent">#2E6BFF</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="Theme.EVChargeCalculator.NoTransition" parent="Theme.EVChargeCalculator">
        <item name="android:windowAnimationStyle">@style/NoWindowAnimation</item>
    </style>
    <style name="NoWindowAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/no_transition</item>
        <item name="android:activityOpenExitAnimation">@anim/no_transition</item>
        <item name="android:activityCloseEnterAnimation">@anim/no_transition</item>
        <item name="android:activityCloseExitAnimation">@anim/no_transition</item>
        <item name="android:taskOpenEnterAnimation">@anim/no_transition</item>
        <item name="android:taskOpenExitAnimation">@anim/no_transition</item>
        <item name="android:taskCloseEnterAnimation">@anim/no_transition</item>
        <item name="android:taskCloseExitAnimation">@anim/no_transition</item>
    </style>
</resources>
